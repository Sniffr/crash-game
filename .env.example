# Copy to .env and fill in. .env is git-ignored.
DATABASE_URL=postgresql://casino:CHANGE_ME@HOST:5432/casino
S3_ENDPOINT=https://eu2.contabostorage.com
S3_REGION=eu2
S3_BUCKET=crash
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_PUBLIC_BASE=https://eu2.contabostorage.com/TENANT:crash

# Player-JWT signing secret (lobby auth). Unset ⇒ auth disabled (503).
JWT_SECRET=CHANGE_ME

# Maplerad real-money wallet (pay-in). Sandbox: mpr_sandbox_sk_… / whsec_…
# Webhook URL: POST https://<host>/api/webhooks/maplerad
MAPLERAD_BASE_URL=https://api.maplerad.com/v1
MAPLERAD_SECRET_KEY=CHANGE_ME
MAPLERAD_WEBHOOK_SECRET=CHANGE_ME

# Fincra pay-in, via hosted Checkout (NOT Direct Charge — that product is
# separately enabled per business). Sandbox host: https://sandboxapi.fincra.com,
# and sandbox takes DIFFERENT keys from live.
# Webhook URL: POST https://<host>/api/webhooks/fincra
FINCRA_BASE_URL=https://api.fincra.com
FINCRA_SECRET_KEY=CHANGE_ME
FINCRA_BUSINESS_ID=CHANGE_ME
# pk_… — Checkout rejects create calls without it. The business id is also the
# first half of this key, base64-decoded.
FINCRA_PUBLIC_KEY=CHANGE_ME
FINCRA_WEBHOOK_SECRET=CHANGE_ME
# Where Fincra returns the payer after the hosted page.
FINCRA_REDIRECT_URL=https://<host>/lobby
# Optional: narrow to the currencies this business is actually enabled for
# (defaults to every rail). Per-business enablement isn't readable over the API.
# FINCRA_CURRENCIES=KES,NGN

# Deposit processor preference — first one that supports the currency AND
# accepts the charge wins; fail-over only on an explicit rejection.
PAYIN_PROVIDER_ORDER=maplerad,fincra

# FX rates to KES for internal MAX_STAKE checks only (never shown to players).
# JSON map of currency → KES per 1 unit. Only exercised on non-KES bets.
FX_RATES={"ZMW":5.5,"ZAR":7.0,"UGX":0.035,"TZS":0.052,"NGN":0.085}

# ─── Simulate game (harvested odds + provably-fair RNG) ──────────────────────
# RTP as a fraction in (0,1]. 0.95 = 95% return-to-player.
SIMULATE_RTP=0.95
# Play-money balance a new Simulate session starts with (credits).
SIMULATE_DEMO_BALANCE=1000
# Max stake per slip (credits).
SIMULATE_MAX_STAKE=1000
# How long the server caches the S3 fixtures feed before re-fetching (ms).
SIMULATE_FEED_TTL_MS=60000

# ─── Odds harvester (services/harvester) ─────────────────────────────────────
# Reuses the S3_* creds above to upload simulate/fixtures/latest.json.
HARVEST_SPORT=football
HARVEST_DAYS=7
# 0 = one-shot (run by the compose service on start); >0 = loop every N seconds.
HARVEST_INTERVAL_SEC=0
HARVEST_HEADLESS=true
